{
  "entities": {
    "Track": {
      "title": "Track",
      "description": "An audio recording stem or track release",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "album": { "type": "string" },
        "coverUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "duration": { "type": "string" }
      },
      "required": ["id", "title", "album", "coverUrl", "audioUrl"]
    },
    "Merchandise": {
      "title": "Merchandise",
      "description": "Store gear, vinyl pressings, apparel or digital items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "price", "image", "category"]
    },
    "TourDate": {
      "title": "TourDate",
      "description": "World sector live tour concert date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "ticketUrl": { "type": "string" },
        "isSoldOut": { "type": "boolean" }
      },
      "required": ["id", "date", "venue", "city", "country"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Studio intel log or field chronicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "title", "content", "date", "imageUrl"]
    },
    "HomeContent": {
      "title": "HomeContent",
      "description": "Dynamic homepage banner, album title and featured track configuration",
      "type": "object",
      "properties": {
        "albumTitle": { "type": "string" },
        "albumSubtitle": { "type": "string" },
        "heroImageUrl": { "type": "string" },
        "featuredTrackId": { "type": "string" },
        "bannerTag": { "type": "string" }
      },
      "required": ["albumTitle", "albumSubtitle"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase requisition and shipment manifest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "createdAt", "total", "paymentMethod", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Comms transmission dispatched by visitor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "createdAt", "name", "email", "message"]
    }
  },
  "firestore": {
    "/tracks/{trackId}": {
      "schema": "Track",
      "description": "Collection of playable audio stems and compositions"
    },
    "/merchandise/{productId}": {
      "schema": "Merchandise",
      "description": "Store gear, apparel, vinyl and stems"
    },
    "/tour_dates/{tourId}": {
      "schema": "TourDate",
      "description": "Live tour locations and tickets"
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Studio intel dispatches"
    },
    "/home_content/config": {
      "schema": "HomeContent",
      "description": "Singleton configuration document for homepage content"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase manifests"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Inbound comms messages"
    }
  }
}
