rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin helper function
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'josephgitongaofficial@gmail.com';
    }

    // Public catalog content (Read by all, editable by admin only)
    match /tracks/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /merchandise/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tour_dates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /home_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders & armory checkout manifests
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages & transmissions
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // User profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
